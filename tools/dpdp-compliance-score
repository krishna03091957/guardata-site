  {id:5,name:'Sharing',max:4},
  {id:6,name:'Breach',max:4},
];

// ══ INIT ══
function init(){
  // Pre-score Q17 if Q16=no
  // Build question cards
  QUESTIONS.forEach(q=>buildCard(q));
  renderProg();
}

function buildCard(q){
  const div=document.createElement('div');
  div.className='qcard';
  div.id='qcard-'+q.id;
  let html='';
  html+=`<div class="q-meta">`;
  html+=`<span class="q-num-badge">Q${q.id} of 20</span>`;
  html+=`<span class="q-ref">${q.ref}</span>`;
  if(q.weighted)html+=`<span class="q-weighted">2× weighted</span>`;
  html+=`</div>`;
  html+=`<div class="q-text">${q.text}</div>`;
  html+=`<div class="q-note">${q.note}</div>`;
  html+=`<div class="ans-grid">`;
  q.opts.forEach((o,i)=>{
    html+=`<button class="ans-btn" data-qid="${q.id}" data-type="${o.type}" data-pts="${o.pts}" onclick="selectAns(this,${q.id},'${o.type}',${o.pts})">`;
    html+=`<span class="ans-ico">${o.ico}</span>`;
    html+=`<div class="ans-body"><span class="ans-label">${o.label}</span><span class="ans-desc">${o.desc}</span></div>`;
    html+=`<div class="ans-tick"><svg viewBox="0 0 10 10"><path d="M1.5 5l2.5 2.5L8.5 2"/></svg></div>`;
    html+=`</button>`;
  });
  html+=`</div>`;
  // Nav
  html+=`<div class="qnav">`;
  html+=`<button class="btn-prev" onclick="goPrev()"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10 4l-4 4 4 4"/></svg> Back</button>`;
  if(q.id<20){
    html+=`<button class="btn-next dimmed" id="btn-next-${q.id}" onclick="goNext()">Next <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 4l4 4-4 4"/></svg></button>`;
  }else{
    html+=`<button class="btn-calc dimmed" id="btn-next-${q.id}" onclick="calculate()"><svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/></svg> Calculate My Score</button>`;
  }
  html+=`</div>`;
  html+=`<div class="key-hint">Press <kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd> to answer · <kbd>Enter</kbd> or <kbd>→</kbd> to continue</div>`;
  div.innerHTML=html;
  document.getElementById('quiz-shell').insertBefore(div, document.getElementById('results'));
}

// ══ SECTOR ══
function setSector(el,s){
  document.querySelectorAll('.sector-btn').forEach(b=>b.classList.remove('on'));
  el.classList.add('on'); sector=s;
  document.getElementById('btn-sector-next').classList.remove('dimmed');
  // Auto-score Q8 for non-child sectors
  if(!['edtech','health'].includes(s)) A[8]=2;
  else delete A[8];
}

// ══ NAVIGATION ══
function showCard(n){
  document.querySelectorAll('.qcard').forEach(c=>c.classList.remove('active'));
  document.getElementById('results').classList.remove('show');
  const card=document.getElementById('qcard-'+n);
  if(card){card.classList.add('active'); cur=n;}
  renderProg();
  window.scrollTo({top:0,behavior:'smooth'});
}

function goNext(){
  if(cur===0){showCard(1);return;}
  // Skip Q17 if Q16 was answered "no" (auto-scored)
  let next=cur+1;
  if(cur===16 && A[16]===2){A[17]=2;next=18;}
  if(next<=20)showCard(next);
  else calculate();
}

function goPrev(){
  if(cur===1){showCard(0);return;}
  let prev=cur-1;
  if(cur===18 && A[16]===2) prev=16; // skip 17 backwards too
  showCard(prev);
}

// ══ ANSWER SELECT ══
function selectAns(el,qid,type,pts){
  const card=document.getElementById('qcard-'+qid);
  card.querySelectorAll('.ans-btn').forEach(b=>{
    b.classList.remove('selected-yes','selected-par','selected-no');
  });
  el.classList.add('selected-'+type);
  A[qid]=pts;
  // Enable next button
  const nb=document.getElementById('btn-next-'+qid);
  if(nb)nb.classList.remove('dimmed');
}

// ══ KEYBOARD ══
document.addEventListener('keydown',e=>{
  if(cur===0) return;
  if(['1','2','3'].includes(e.key)){
    const card=document.getElementById('qcard-'+cur);
    if(!card) return;
    const btns=card.querySelectorAll('.ans-btn');
    const i=parseInt(e.key)-1;
    if(btns[i]) btns[i].click();
  }
  if(e.key==='Enter'||e.key==='ArrowRight'){
    const nb=document.getElementById('btn-next-'+cur);
    if(nb&&!nb.classList.contains('dimmed')) nb.click();
  }
  if(e.key==='ArrowLeft') goPrev();
});

// ══ PROGRESS ══
const CAT_LABELS=['Sector','Privacy Policy','Privacy Policy','Privacy Policy','Privacy Policy','Consent','Consent','Consent','Consent','Data Security','Data Security','Data Security','Data Security','Retention','Retention','Retention','Data Sharing','Data Sharing','Data Sharing','Breach Readiness','Breach Readiness'];
function renderProg(){
  const total=20;
  const pct=cur===0?0:Math.round((cur/total)*100);
  document.getElementById('qbar').style.width=pct+'%';
  document.getElementById('qprog-label').textContent=cur===0?'Select your sector':`Question ${cur} of ${total}`;
  document.getElementById('qprog-cat').textContent=CAT_LABELS[cur]||'';
}

// ══ SCORE CALCULATION ══
function calculate(){
  // Defaults for unanswered
  for(let i=1;i<=20;i++){if(A[i]===undefined)A[i]=0;}

  // Category raw scores (weighted questions x2)
  const c1=A[1]*2+A[2]+A[3]+A[4]; // max 10
  const c2=A[5]*2+A[6]+A[7]+A[8]; // max 10
  const c3=A[9]*2+A[10]+A[11]+A[12]; // max 10
  const c4=A[13]+A[14]+A[15]; // max 6
  const c5=(A[16]===2?2:0)+A[17]+A[18]; // if no sharing, q16 auto scored 2, q17 auto 2
  // Fix: if q16=no (pts=2), q17 should also be 2
  let c5fixed=c1+0; // recalc
  if(A[16]===2){c5fixed=2+2+A[18];} // no sharing = auto pass q16+q17
  else{c5fixed=(A[16]||0)+(A[17]||0)+A[18];}
  const c6=A[19]+A[20]; // max 4

  const catScores=[c1,c2,c3,c4,c5fixed,c6];
  const raw=c1+c2+c3+c4+c5fixed+c6;
  const score=Math.round((raw/44)*100);

  showResults(score,catScores);
}

function showResults(score,catScores){
  document.querySelectorAll('.qcard').forEach(c=>c.classList.remove('active'));
  document.getElementById('qprog').style.display='none';
  document.getElementById('results').classList.add('show');

  const daysLeft=Math.max(0,Math.floor((new Date('2027-05-13')-new Date())/(864e5)));
  document.getElementById('r-days').textContent=daysLeft;

  let color,risk,headline,summary;
  const gaps=buildGaps();
  const nc=gaps.filter(g=>g.sev==='crit').length;
  const ni=gaps.filter(g=>g.sev==='imp').length;

  if(score>=80){
    color='#10B981';risk='🟢 Compliant — Low Risk';
    headline='Strong DPDP Foundation';
    summary=`You've done the hard work. Your compliance foundation is solid with ${ni>0?ni+' minor gap'+(ni>1?'s':'')+' to close':' only small items remaining'}. Use the checklist below to finish before May 2027.`;
  }else if(score>=55){
    color='#F59E0B';risk='🟡 Partial — Medium Risk';
    headline='On the Right Track — But Gaps Remain';
    summary=`You've started your DPDP journey but ${nc+ni} gap${nc+ni>1?'s':''} could expose you to penalties. Most are fixable in under a week. Focus on the Critical items first.`;
  }else if(score>=30){
    color='#F97316';risk='🟠 At Risk — High Risk';
    headline='Significant Compliance Gaps Detected';
    summary=`Your business has ${nc+ni} gaps including ${nc} critical issue${nc!==1?'s':''}. A single complaint to the Data Protection Board could trigger a fine. You have ${daysLeft} days until enforcement.`;
  }else{
    color='#DC2626';risk='🔴 Non-Compliant — Critical Risk';
    headline='Critical Compliance Failures Found';
    summary=`${nc} critical violation${nc!==1?'s were':' was'} identified that could each result in fines from ₹50 crore to ₹250 crore. Enforcement begins May 13, 2027 — ${daysLeft} days away. Most Critical items below can be fixed this week.`;
  }

  const badge=document.getElementById('r-badge');
  badge.textContent=risk;
  badge.style.background=color+'22';badge.style.color=color;badge.style.border=`1px solid ${color}55`;

  const fill=document.getElementById('ring-fill');
  const circ=2*Math.PI*65;
  fill.style.stroke=color;
  fill.style.strokeDasharray=circ;
  fill.style.strokeDashoffset=circ;
  document.getElementById('r-num').textContent='0';
  document.getElementById('r-headline').textContent=headline;
  document.getElementById('r-summary').textContent=summary;

  setTimeout(()=>{
    fill.style.strokeDashoffset=circ*(1-score/100);
    let n=0;const iv=setInterval(()=>{
      n=Math.min(n+Math.ceil(score/35),score);
      document.getElementById('r-num').textContent=n;
      if(n>=score)clearInterval(iv);
    },28);
  },200);

  const catMaxes=[10,10,10,6,4,4];
  setTimeout(()=>{
    catScores.forEach((s,i)=>{
      const pct=Math.round((s/catMaxes[i])*100);
      const bar=document.getElementById('cb'+(i+1));
      bar.style.background=pct>=80?'#10B981':pct>=55?'#F59E0B':pct>=30?'#F97316':'#DC2626';
      bar.style.width=pct+'%';
      document.getElementById('cp'+(i+1)).textContent=pct+'%';
    });
  },400);

  // Sector alert
  const sa=SECTORS[sector];
  if(sa){
    document.getElementById('r-sec-alert').style.display='';
    document.getElementById('r-sec-title').textContent=sa.title;
    document.getElementById('r-sec-body').innerHTML=sa.body;
  }

  // Gaps
  const crits=gaps.filter(g=>g.sev==='crit');
  const imps=gaps.filter(g=>g.sev==='imp');
  if(crits.length){
    document.getElementById('r-crit-card').style.display='';
    document.getElementById('r-crit').innerHTML=crits.map(gHtml).join('');
  }
  if(imps.length){
    document.getElementById('r-imp-card').style.display='';
    document.getElementById('r-imp').innerHTML=imps.map(gHtml).join('');
  }

  // Wins
  const wins=buildWins();
  if(wins.length){
    document.getElementById('r-win-card').style.display='';
    document.getElementById('r-wins').innerHTML=wins.map(w=>`<div class="win-item">${w}</div>`).join('');
  }

  window.scrollTo({top:0,behavior:'smooth'});
}

function gHtml(g){
  return`<div class="gap-item ${g.sev}"><div class="gap-top"><div class="gap-title">${g.title}</div><div class="gap-pen">${g.pen}</div></div><div class="gap-msg">${g.msg}</div><a class="gap-cta" href="${g.url}" target="_blank" rel="noopener">${g.cta}</a></div>`;
}

