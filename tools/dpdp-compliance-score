// ══ STATE ══
let cur=0; // 0=sector, 1–20=questions, 21=results
let sector='other';
const A={}; // qId → pts

const CATS=[
  {id:1,name:'Privacy Policy',max:10},
  {id:2,name:'Consent',max:10},
  {id:3,name:'Security',max:10},
