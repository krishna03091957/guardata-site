  else if(A[1]===1)g.push({sev:'imp',title:'Privacy policy drafted but not live',pen:'₹50 crore risk',msg:'Your draft needs to be published and linked from your website footer and every form that collects personal data.',cta:'Complete and publish your policy →',url:'https://guardata.in/tools/dpdp-privacy-policy-generator'});
  // Q2
  if(A[2]<2)g.push({sev:'imp',title:'Policy doesn\'t itemise data types and specific purposes',pen:'Non-compliant',msg:'Rule 3(1)(b) requires an itemised description of personal data and the specific purpose for each. "We collect data to improve services" is not enough.',cta:'What your policy must include →',url:'https://guardata.in/blog/what-is-dpdp-act.html'});
  // Q3
  if(A[3]===0)g.push({sev:'imp',title:'No retention periods stated in policy',pen:'Rule 8 violation',msg:'Rule 8 requires specific retention periods for each data category. New: processing logs must be kept for at least 1 year for all Data Fiduciaries.',cta:'Retention period examples →',url:'https://guardata.in/blog/what-is-dpdp-act.html'});
  // Q4
  if(A[4]===0)g.push({sev:'imp',title:'No Grievance Officer named — Rule 9 violation',pen:'₹50 crore',msg:'Rule 9 requires every Data Fiduciary to appoint and publish a Grievance Officer. Complaints must be resolved within 90 days. This can be you — just list your name and email.',cta:'Add Grievance Officer to your policy →',url:'https://guardata.in/tools/dpdp-privacy-policy-generator'});
  // Q5
  if(A[5]===0)g.push({sev:'crit',title:'No consent collected before processing data',pen:'₹50 crore',msg:'DPDP requires free, specific, informed, unconditional, and unambiguous consent with clear affirmative action. Processing without it is one of the most penalised DPDP violations.',cta:'What valid DPDP consent looks like →',url:'https://guardata.in/blog/what-is-dpdp-act.html'});
  else if(A[5]===1)g.push({sev:'crit',title:'Pre-ticked consent checkbox — legally invalid',pen:'₹50 crore',msg:'Pre-ticked boxes are explicitly invalid. The user must actively tick the box. Un-tick your checkboxes by default immediately.',cta:'Valid DPDP consent guide →',url:'https://guardata.in/blog/what-is-dpdp-act.html'});
  // Q6
  if(A[6]<2)g.push({sev:'imp',title:'Consent not a standalone notice — Rule 3(1)(a) violation',pen:'Invalid consent',msg:'Rule 3(1)(a) requires the consent notice to be understandable independently of any other information. Bundling with T&C makes consent invalid.',cta:'See standalone consent examples →',url:'https://guardata.in/blog/what-is-dpdp-act.html'});
  // Q7
  if(A[7]===0)g.push({sev:'imp',title:'No consent withdrawal mechanism',pen:'₹50 crore',msg:'DPDP require withdrawal to be as easy as giving consent. Add a one-click unsubscribe, account deletion, or accessible privacy settings.',cta:'Data Principal rights under DPDP →',url:'https://guardata.in/blog/what-is-dpdp-act.html'});
  // Q8 (child sectors only flagged as critical)
  if(A[8]===0&&['edtech','health'].includes(sector))g.push({sev:'crit',title:'No verifiable parental consent for minor users',pen:'₹200 crore',msg:'Rule 10 requires verifiable parental consent using identity/age verification — including DigiLocker or equivalent. Asking the child themselves = not compliant.',cta:'Children\'s data compliance guide →',url:'https://guardata.in/blog/dpdp-edtech-tutors.html'});
  else if(A[8]===1&&['edtech','health'].includes(sector))g.push({sev:'crit',title:'Parental consent collected from the child — not compliant',pen:'₹200 crore',msg:'Rule 10 requires VERIFIABLE parental or guardian consent — not a self-declaration by the minor. Implement age-gating with parent-verified email or DigiLocker.',cta:'Children\'s data guide →',url:'https://guardata.in/blog/dpdp-edtech-tutors.html'});
  // Q9
  if(A[9]===0)g.push({sev:'crit',title:'Personal data in unprotected storage — Rule 6 violation',pen:'₹250 crore',msg:'Rule 6 requires encryption at rest and in transit, access controls, MFA, and 1-year activity logging. Open spreadsheets or unprotected drives carry the maximum possible DPDP penalty.',cta:'Data security requirements →',url:'https://guardata.in/blog/dpdp-penalties.html'});
  else if(A[9]===1)g.push({sev:'imp',title:'Basic security only — encryption and logging missing',pen:'Partial Rule 6 compliance',msg:'Passwords alone don\'t meet Rule 6. Add: encryption at rest + in transit, role-based access, MFA on all admin accounts, and 1-year activity log retention.',cta:'Security requirements checklist →',url:'https://guardata.in/blog/dpdp-for-startups.html'});
  // Q10
  if(A[10]===0)g.push({sev:'crit',title:'Website running without HTTPS — Rule 6 violation',pen:'₹250 crore',msg:'All data in your forms travels unencrypted. This is a critical security failure under Rule 6. Enable HTTPS via your hosting provider — Let\'s Encrypt is free.',cta:'How to enable HTTPS →',url:'https://guardata.in/blog/dpdp-for-startups.html'});
  // Q11
  if(A[11]===0)g.push({sev:'imp',title:'No role-based access controls — Rule 6(2) violation',pen:'Security violation',msg:'Rule 6(2) requires access controls so staff only see data relevant to their role. Implement role-based permissions: billing sees billing, support sees support history.',cta:'Access control guide →',url:'https://guardata.in/blog/dpdp-for-startups.html'});
  // Q12
  if(A[12]===0)g.push({sev:'imp',title:'No MFA on accounts holding customer data — Rule 6',pen:'Security exposure',msg:'Rule 6 mandates multi-factor authentication as a baseline. Enable on Google Workspace, CRM, admin panels, analytics, and payment dashboards. Takes 5 minutes, free on all major platforms.',cta:'Security checklist →',url:'https://guardata.in/blog/dpdp-for-ecommerce.html'});
  // Q13
  if(A[13]===0)g.push({sev:'imp',title:'No data deletion policy — Rule 8 violation',pen:'₹50 crore',msg:'Rule 8 requires you to define retention periods and delete data when purpose is served. New: processing logs must be retained for a minimum 1 year (not deleted earlier).',cta:'Retention policy guide →',url:'https://guardata.in/blog/what-is-dpdp-act.html'});
  // Q14
  if(A[14]===0)g.push({sev:'imp',title:'Cannot delete a customer\'s data on request — Rule 14',pen:'₹50 crore',msg:'Rule 14 requires you to respond to erasure requests within 90 days with a written explanation if unable. You must be able to locate and delete a specific person\'s data across all systems.',cta:'Erasure request guide →',url:'https://guardata.in/blog/dpdp-for-ecommerce.html'});
  // Q15
  if(A[15]<2)g.push({sev:'imp',title:'No data map — can\'t protect or report what you can\'t find',pen:'Compliance blocker',msg:'Without a data inventory, you cannot: comply with Rule 6 security, report a breach per Rule 7, or respond to erasure requests per Rule 14. Spend 2 hours building a simple spreadsheet.',cta:'How to create a data map →',url:'https://guardata.in/blog/dpdp-for-startups.html'});
  // Q17
  if(A[17]<2&&A[16]!==2)g.push({sev:'imp',title:'Third-party data sharing not disclosed in policy',pen:'₹50 crore',msg:'Rule 3(1)(b) requires you to name all third parties you share data with. Generic language like "trusted partners" is not compliant — name each vendor and their purpose.',cta:'Update your privacy policy →',url:'https://guardata.in/tools/dpdp-privacy-policy-generator'});
  // Q18
  if(A[18]===0)g.push({sev:'imp',title:'No Data Processing Agreements with vendors — Rule 11',pen:'Medium-high liability',msg:'Rule 11 requires contractual obligations on Data Processors. Check Mailchimp, Razorpay, Freshdesk, Google\'s legal pages — most provide DPAs. Without one you cannot enforce DPDP compliance on your vendors.',cta:'What is a DPA? →',url:'https://guardata.in/blog/dpdp-saas-b2b.html'});
  // Q19
  if(A[19]===0)g.push({sev:'crit',title:'No breach response plan — every breach triggers Rule 7',pen:'₹200 crore',msg:'Rule 7 requires notification to DPBI within 72 hours of EVERY breach (no minimum threshold). Without a written plan you will miss this window. Create one now: who to call, how to assess, how to notify.',cta:'Breach notification guide →',url:'https://guardata.in/blog/dpdp-penalties.html'});
  // Q20
  if(A[20]===0)g.push({sev:'crit',title:'Unaware of 72-hour DPBI notification requirement',pen:'₹200 crore',msg:'Rule 7(1): every personal data breach triggers mandatory notification to DPBI within 72 hours of discovery — no minimum severity threshold (unlike GDPR). Missing this window alone = ₹200 crore.',cta:'DPDP penalties explained →',url:'https://guardata.in/blog/dpdp-penalties.html'});

  return g;
}

function buildWins(){
  const w=[];
  if(A[1]===2)w.push('Privacy policy published and standalone per Rule 3');
  if(A[2]===2)w.push('Policy itemises data types and specific purposes');
  if(A[3]===2)w.push('Retention periods stated including 1-year log minimum');
  if(A[4]===2)w.push('Grievance Officer named with contact details (Rule 9)');
  if(A[5]===2)w.push('Explicit, active consent collected before processing');
  if(A[6]===2)w.push('Consent notice is standalone per Rule 3(1)(a)');
  if(A[7]===2)w.push('Withdrawal mechanism as easy as giving consent');
  if(A[8]===2&&['edtech','health'].includes(sector))w.push('Verifiable parental consent in place (Rule 10)');
  if(A[9]===2)w.push('Data encrypted at rest + in transit, MFA, activity logging (Rule 6)');
  if(A[10]===2)w.push('HTTPS / SSL active on all pages');
  if(A[11]===2)w.push('Role-based access controls implemented');
  if(A[12]===2)w.push('MFA/2FA on all accounts holding customer data');
  if(A[13]===2)w.push('Data deletion policy in place with defined triggers');
  if(A[14]===2)w.push('Can respond to erasure requests within 90 days (Rule 14)');
  if(A[15]===2)w.push('Data map / inventory maintained');
  if(A[18]===2)w.push('Data Processing Agreements in place with vendors (Rule 11)');
  if(A[19]===2)w.push('Written breach response plan exists');
  if(A[20]===2)w.push('72-hour DPBI notification process in place (Rule 7)');
  return w;
}

function sendReport(){
  const e=document.getElementById('email-inp').value.trim();
  if(!e||!e.includes('@')){showToast('Please enter a valid email');return;}
  showToast('✓ Report on its way to '+e);
  document.getElementById('email-inp').value='';
}

function restart(){
  Object.keys(A).forEach(k=>delete A[k]);
  sector='other';
  document.querySelectorAll('.sector-btn').forEach(b=>b.classList.remove('on'));
  document.querySelectorAll('.ans-btn').forEach(b=>b.classList.remove('selected-yes','selected-par','selected-no'));
  document.querySelectorAll('.btn-next,.btn-calc').forEach(b=>{if(b.id!=='btn-sector-next')b.classList.add('dimmed');});
  document.getElementById('btn-sector-next').classList.add('dimmed');
  document.getElementById('results').classList.remove('show');
  document.getElementById('r-crit-card').style.display='none';
  document.getElementById('r-imp-card').style.display='none';
  document.getElementById('r-win-card').style.display='none';
  document.getElementById('r-sec-alert').style.display='none';
  document.getElementById('qprog').style.display='';
  cur=0;
  document.querySelectorAll('.qcard').forEach(c=>c.classList.remove('active'));
  document.getElementById('qcard-0').classList.add('active');
  renderProg();
  window.scrollTo({top:0,behavior:'smooth'});
}

function showToast(msg){
  const t=document.getElementById('toastEl');
  t.textContent=msg;t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),2800);
}

// Init
init();
</script>
