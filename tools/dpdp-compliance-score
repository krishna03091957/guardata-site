<style>
:root{
  --w:#FFFFFF;--off:#FAFBFC;--lg:#F5F7FA;--bd:#E4E7EB;
  --t:#0F172A;--t2:#374151;--mu:#64748B;--su:#94A3B8;
  --pr:#FF6B35;--pd:#E55A2B;--pl:#FFF0EB;--pm:#FED4C3;
  --nv:#0F4C81;--nl:#1E5A8E;--nli:#EEF4FB;
  --ok:#10B981;--okl:#ECFDF5;--okb:#6EE7B7;
  --yw:#F59E0B;--ywl:#FFFBEB;--ywb:#FCD34D;
  --or:#F97316;--orl:#FFF7ED;--orb:#FDBA74;
  --rd:#DC2626;--rdl:#FEF2F2;--rdb:#FCA5A5;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Manrope',sans-serif;background:var(--off);color:var(--t);font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased;min-height:100vh}



/* ── HERO ── */
.hero{background:linear-gradient(135deg,var(--nv) 0%,var(--nl) 100%);padding:20px 32px 18px;position:relative;overflow:hidden}
.hero::after{content:'';position:absolute;top:-80%;right:-5%;width:360px;height:360px;background:radial-gradient(circle,rgba(255,107,53,.18) 0%,transparent 70%);border-radius:50%;pointer-events:none}
.hero-in{max-width:480px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:10px;position:relative;z-index:1}
.hero-l{}
.hbadge{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.15);color:rgba(255,255,255,.88);font-size:10.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:3px 9px;border-radius:20px;margin-bottom:7px}
.hbadge span{width:5px;height:5px;background:var(--pr);border-radius:50%;display:inline-block}
.hero h1{font-family:'DM Sans',sans-serif;font-size:clamp(40px,2.5vw,22px);font-weight:700;color:white;letter-spacing:-.3px;line-height:1.00;margin-bottom:4px}
.hero h1 em{font-style:normal;color:var(--pr)}
.hero p{color:rgba(255,255,255,.62);font-size:12px;line-height:1.6}
.hero-stats{display:flex;gap:7px;flex-shrink:0}
.hstat{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.11);border-radius:8px;padding:8px 13px;text-align:center}
.hstat .n{font-family:'DM Sans',sans-serif;font-size:16px;font-weight:700;color:var(--pr);line-height:1}
.hstat .l{font-size:9.5px;color:rgba(255,255,255,.45);margin-top:2px}
@media(max-width:540px){.hero{padding:16px 20px}.hero-in{flex-direction:column;align-items:flex-start;gap:10px}.hero-stats{display:none}}

/* ── QUIZ SHELL ── */
.quiz-shell{max-width:680px;margin:0 auto;padding:24px 20px 60px;min-height:calc(100vh - 52px - 110px)}

/* ── PROGRESS ── */
.qprog{margin-bottom:18px}
.qprog-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.qprog-label{font-family:'JetBrains Mono',monospace;font-size:11.5px;font-weight:500;color:var(--mu)}
.qprog-cat{font-size:11.5px;font-weight:700;color:var(--nv);background:var(--nli);padding:2px 9px;border-radius:10px}
.qbar-wrap{height:4px;background:var(--bd);border-radius:2px;overflow:hidden}
.qbar{height:100%;background:linear-gradient(90deg,var(--nv),var(--pr));border-radius:2px;transition:width .4s cubic-bezier(.4,0,.2,1)}

/* ── QUESTION CARD ── */
.qcard{background:var(--w);border:1px solid var(--bd);border-radius:14px;padding:20px 20px 20px;display:none;animation:fadeIn .2s ease}
.qcard.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}

.qcard-sector .sector-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(185px,1fr));gap:8px;margin-top:16px}
.sector-btn{padding:11px 13px;border:1.5px solid var(--bd);border-radius:9px;cursor:pointer;background:var(--w);text-align:left;transition:all .15s;display:flex;align-items:center;gap:9px}
.sector-btn:hover{border-color:#9CA3AF;background:var(--lg)}
.sector-btn.on{border-color:var(--pr);background:var(--pl);box-shadow:0 0 0 2px rgba(255,107,53,.12)}
.sector-btn .si{font-size:20px;flex-shrink:0}
.sector-btn .st{font-size:12.5px;font-weight:600;color:var(--t)}
.sector-btn .sd{font-size:11px;color:var(--mu);margin-top:1px}

/* Question header */
.q-meta{display:flex;align-items:center;gap:7px;margin-bottom:12px;flex-wrap:wrap}
.q-num-badge{font-family:'JetBrains Mono',monospace;font-size:10.5px;font-weight:500;background:var(--pl);color:var(--pr);padding:3px 9px;border-radius:6px}
.q-ref{font-family:'JetBrains Mono',monospace;font-size:9.5px;background:#FFF3E0;color:#92400E;padding:2px 6px;border-radius:4px}
.q-weighted{font-family:'JetBrains Mono',monospace;font-size:9px;background:var(--nli);color:var(--nv);padding:2px 6px;border-radius:4px}
.q-text{font-family:'DM Sans',sans-serif;font-size:18px;font-weight:700;color:var(--t);letter-spacing:-.3px;line-height:1.35;margin-bottom:6px}
@media(max-width:480px){.q-text{font-size:16px}}
.q-note{font-size:12.5px;color:var(--mu);line-height:1.6;margin-bottom:20px;padding:10px 13px;background:var(--lg);border-radius:8px;border-left:3px solid var(--bd)}
.q-note strong{color:var(--t2)}

/* Answer options */
.ans-grid{display:flex;flex-direction:column;gap:9px}
.ans-btn{width:100%;padding:14px 18px;border:2px solid var(--bd);border-radius:11px;cursor:pointer;background:var(--w);text-align:left;transition:all .18s;display:flex;align-items:center;gap:14px}
.ans-btn:hover{border-color:#9CA3AF;background:#F9FAFB;transform:translateX(2px)}
.ans-btn.selected-yes{border-color:var(--ok);background:var(--okl);box-shadow:0 0 0 3px rgba(16,185,129,.12)}
.ans-btn.selected-par{border-color:var(--yw);background:var(--ywl);box-shadow:0 0 0 3px rgba(245,158,11,.12)}
.ans-btn.selected-no{border-color:var(--rd);background:var(--rdl);box-shadow:0 0 0 3px rgba(220,38,38,.1)}
.ans-ico{font-size:22px;flex-shrink:0;width:28px;text-align:center}
.ans-body{flex:1}
.ans-label{font-size:14px;font-weight:700;color:var(--t);display:block;margin-bottom:1px}
.ans-desc{font-size:12px;color:var(--mu);line-height:1.4}
.ans-tick{width:20px;height:20px;border-radius:50%;border:2px solid var(--bd);flex-shrink:0;display:flex;align-items:center;justify-content:center;transition:all .18s;margin-left:auto}
.ans-btn.selected-yes .ans-tick{border-color:var(--ok);background:var(--ok)}
.ans-btn.selected-par .ans-tick{border-color:var(--yw);background:var(--yw)}
.ans-btn.selected-no .ans-tick{border-color:var(--rd);background:var(--rd)}
.ans-tick svg{width:10px;height:10px;stroke:white;stroke-width:3;fill:none;display:none}
.ans-btn.selected-yes .ans-tick svg,.ans-btn.selected-par .ans-tick svg,.ans-btn.selected-no .ans-tick svg{display:block}

/* Navigation */
.qnav{display:flex;justify-content:space-between;align-items:center;margin-top:24px;padding-top:18px;border-top:1px solid var(--bd)}
.btn-prev{padding:10px 18px;background:transparent;border:1.5px solid var(--bd);border-radius:8px;font-family:'Manrope',sans-serif;font-size:13.5px;font-weight:600;color:var(--mu);cursor:pointer;transition:all .15s;display:flex;align-items:center;gap:5px}
.btn-prev:hover{border-color:var(--nv);color:var(--nv)}
.btn-prev svg,.btn-next svg{width:14px;height:14px}
.btn-next{padding:10px 22px;background:var(--nv);color:white;border:none;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:14px;font-weight:700;cursor:pointer;transition:background .15s,opacity .15s;display:flex;align-items:center;gap:7px;box-shadow:0 2px 6px rgba(15,76,129,.2)}
.btn-next:hover{background:var(--nl)}
.btn-next.dimmed{opacity:.5;cursor:not-allowed}
.btn-next.dimmed:hover{background:var(--nv)}
.btn-calc{padding:10px 22px;background:var(--pr);color:white;border:none;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:14px;font-weight:700;cursor:pointer;transition:background .15s;display:flex;align-items:center;gap:7px;box-shadow:0 2px 8px rgba(255,107,53,.28)}
.btn-calc:hover{background:var(--pd)}
.btn-calc svg{width:15px;height:15px}

/* Keyboard hint */
.key-hint{font-size:11px;color:var(--su);text-align:center;margin-top:10px}
.key-hint kbd{font-family:'JetBrains Mono',monospace;font-size:10px;background:var(--lg);border:1px solid var(--bd);padding:1px 5px;border-radius:4px}

/* ── RESULTS ── */
.results{display:none;animation:fadeIn .3s ease}
.results.show{display:block}

.score-card{background:var(--w);border:1px solid var(--bd);border-radius:14px;padding:28px;margin-bottom:14px;text-align:center}
.score-badge{display:inline-flex;align-items:center;gap:7px;padding:5px 14px;border-radius:20px;font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;margin-bottom:16px}
.ring-wrap{position:relative;width:148px;height:148px;margin:0 auto 18px}
.ring-svg{transform:rotate(-90deg)}
.ring-bg{fill:none;stroke:var(--bd);stroke-width:10}
.ring-fill{fill:none;stroke-width:10;stroke-linecap:round;transition:stroke-dashoffset 1.4s cubic-bezier(.4,0,.2,1);stroke-dasharray:408;stroke-dashoffset:408}
.ring-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
.ring-center .big{font-family:'DM Sans',sans-serif;font-size:38px;font-weight:700;line-height:1;color:var(--t)}
.ring-center .of{font-size:12.5px;color:var(--mu);font-weight:500}
.score-headline{font-family:'DM Sans',sans-serif;font-size:20px;font-weight:700;letter-spacing:-.3px;margin-bottom:7px}
.score-summary{font-size:13.5px;color:var(--t2);line-height:1.7;max-width:480px;margin:0 auto}
.deadline-row{display:inline-flex;align-items:center;gap:6px;background:var(--rdl);border:1px solid var(--rdb);color:var(--rd);font-size:11.5px;font-weight:700;padding:5px 14px;border-radius:20px;margin-top:14px}

/* Category bars */
.cat-card{background:var(--w);border:1px solid var(--bd);border-radius:12px;padding:18px 22px;margin-bottom:12px}
.cat-card h3{font-family:'DM Sans',sans-serif;font-size:13.5px;font-weight:700;color:var(--nv);margin-bottom:14px}
.cat-row{display:flex;align-items:center;gap:10px;margin-bottom:9px}
.cat-name{font-size:12.5px;font-weight:600;color:var(--t2);width:148px;flex-shrink:0}
.cat-bar-wrap{flex:1;height:7px;background:var(--bd);border-radius:4px;overflow:hidden}
.cat-bar{height:100%;border-radius:4px;transition:width 1.1s cubic-bezier(.4,0,.2,1);width:0}
.cat-pct{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--mu);width:30px;text-align:right;flex-shrink:0}

/* Gaps */
.gap-card{background:var(--w);border:1px solid var(--bd);border-radius:12px;padding:18px 20px;margin-bottom:12px}
.gap-card h3{font-family:'DM Sans',sans-serif;font-size:13.5px;font-weight:700;margin-bottom:12px;display:flex;align-items:center;gap:6px}
.gap-item{border:1px solid var(--bd);border-radius:9px;padding:13px 15px;margin-bottom:8px}
.gap-item:last-child{margin-bottom:0}
.gap-item.crit{border-color:var(--rdb);background:var(--rdl)}
.gap-item.imp{border-color:var(--orb);background:var(--orl)}
.gap-top{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin-bottom:5px}
.gap-title{font-size:13px;font-weight:700;color:var(--t);flex:1;line-height:1.35}
.gap-pen{font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:500;padding:2px 6px;border-radius:4px;flex-shrink:0;white-space:nowrap}
.gap-item.crit .gap-pen{background:var(--rdb);color:#7F1D1D}
.gap-item.imp .gap-pen{background:var(--orb);color:#7C2D12}
.gap-msg{font-size:12.5px;color:var(--t2);line-height:1.6;margin-bottom:7px}
.gap-cta{font-size:12px;font-weight:700;color:var(--nv);text-decoration:none;transition:color .15s}
.gap-cta:hover{color:var(--pr)}
.gap-cta::after{content:' →'}

/* Wins */
.win-card{background:var(--okl);border:1px solid var(--okb);border-radius:12px;padding:16px 20px;margin-bottom:12px}
.win-card h3{font-size:13px;font-weight:700;color:#065F46;margin-bottom:9px}
.win-item{font-size:12.5px;color:#065F46;padding:3px 0;display:flex;align-items:flex-start;gap:7px;line-height:1.5}
.win-item::before{content:'✓';font-weight:700;flex-shrink:0}

/* Sector alert */
.sec-alert{background:#FFFBEB;border-left:3px solid var(--yw);padding:13px 16px;border-radius:0 9px 9px 0;margin-bottom:12px}
.sec-alert strong{font-size:12.5px;font-weight:700;color:#92400E;display:block;margin-bottom:4px}
.sec-alert p{font-size:12.5px;color:#78350F;line-height:1.6}
.sec-alert a{color:var(--nv);font-weight:600;text-decoration:none}

/* New DPDP Rules 2025 badge */
.rules-badge{display:inline-flex;align-items:center;gap:5px;background:#EEF4FB;border:1px solid #B0C4DE;color:var(--nv);font-size:10.5px;font-weight:600;padding:2px 8px;border-radius:5px;margin-left:4px;vertical-align:middle}

/* Email capture */
.email-card{background:linear-gradient(135deg,var(--nv),var(--nl));border-radius:12px;padding:22px;margin-bottom:12px;color:white}
.email-card h3{font-family:'DM Sans',sans-serif;font-size:16px;font-weight:700;margin-bottom:5px}
.email-card p{font-size:12.5px;color:rgba(255,255,255,.72);margin-bottom:14px;line-height:1.6}
.email-perks{display:flex;flex-direction:column;gap:4px;margin-bottom:16px}
.email-perk{font-size:12px;color:rgba(255,255,255,.82);display:flex;align-items:center;gap:6px}
.email-perk::before{content:'→';color:var(--pr);font-weight:700}
.email-row{display:flex;gap:7px}
.email-row input{flex:1;padding:9px 13px;border:1.5px solid rgba(255,255,255,.2);border-radius:7px;background:rgba(255,255,255,.1);color:white;font-family:'Manrope',sans-serif;font-size:13.5px;outline:none;transition:border-color .2s}
.email-row input::placeholder{color:rgba(255,255,255,.38)}
.email-row input:focus{border-color:rgba(255,255,255,.5)}
.btn-send{padding:9px 16px;background:var(--pr);color:white;border:none;border-radius:7px;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:700;cursor:pointer;flex-shrink:0;transition:background .15s}
.btn-send:hover{background:var(--pd)}
.email-note{font-size:10.5px;color:rgba(255,255,255,.4);margin-top:7px}

.retry-row{display:flex;gap:9px;flex-wrap:wrap}
.btn-retry{padding:9px 16px;background:var(--w);border:1.5px solid var(--bd);border-radius:8px;font-family:'Manrope',sans-serif;font-size:13px;font-weight:600;color:var(--t);cursor:pointer;transition:all .15s;display:flex;align-items:center;gap:5px}
.btn-retry:hover{border-color:var(--nv);color:var(--nv)}
.btn-genpol{padding:9px 16px;background:var(--pr);color:white;border:none;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:700;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:5px;transition:background .15s}
.btn-genpol:hover{background:var(--pd)}

/* ── SEO SECTION ── */
.seo-wrap{max-width:680px;margin:0 auto;padding:0 20px 80px}
.seo-h2{font-family:'DM Sans',sans-serif;font-size:17px;font-weight:700;color:var(--nv);letter-spacing:-.3px;margin-bottom:12px}
.seo-sec{margin-bottom:40px}
.score-bands{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:0}
@media(max-width:480px){.score-bands{grid-template-columns:repeat(2,1fr)}}
.band{background:var(--w);border:1px solid var(--bd);border-radius:9px;padding:12px;text-align:center}
.band .bnum{font-family:'DM Sans',sans-serif;font-size:18px;font-weight:800;line-height:1}
.band .blbl{font-size:11px;font-weight:700;margin-top:3px}
.band .bsub{font-size:10.5px;color:var(--mu);margin-top:2px}
.faq-list{border:1px solid var(--bd);border-radius:12px;overflow:hidden}
.faq-list details{background:var(--w)}
.faq-list details+details{border-top:1px solid var(--bd)}
